<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Amtsblick.Core\Amtsblick.Core.csproj" />
    <ProjectReference Include="..\Amtsblick.Modules.Wasser\Amtsblick.Modules.Wasser.csproj" />
    <ProjectReference Include="..\Amtsblick.Modules.Wetter\Amtsblick.Modules.Wetter.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
  </ItemGroup>

  <!-- Die Konfiguration wird neben der Programmdatei gesucht, damit der Start per stdio
       aus jedem Arbeitsverzeichnis funktioniert. -->
  <ItemGroup>
    <Content Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
